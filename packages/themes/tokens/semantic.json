  "control": {
    "size": {
      "sm": {
        "min": {
          "$type": "dimension",
          "$value": "{control.min.sm}",
          "$description": "Small control minimum block size."
        },
        "padding": {
          "block": {
            "$type": "dimension",
            "$value": "{space.2}",
            "$description": "Small control block padding."
          },
          "inline": {
            "$type": "dimension",
            "$value": "{space.3}",
            "$description": "Small control inline padding."
          }
        }
      },
      "md": {
        "min": {
          "$type": "dimension",
          "$value": "{control.min.md}",
