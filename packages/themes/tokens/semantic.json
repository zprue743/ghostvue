        "$type": "color",
        "$value": "{color.ink}",
        "$description": "Outer color of the two-color keyboard focus indicator."
      },
      "contrast": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Inner color of the two-color keyboard focus indicator."
