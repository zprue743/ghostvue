{
  "surface": {
    "bg": {
      "$type": "color",
      "$value": "{color.white}",
      "$description": "Theme canvas background."
    },
    "fg": {
      "$type": "color",
      "$value": "{color.ink}",
      "$description": "Theme canvas foreground."
    },
    "muted": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.100}",
        "$description": "Muted surface fill behind grouped content."
      }
    },
    "subtle": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Subtle surface fill for inset regions."
      }
    },
    "inverse": {
      "bg": {
        "$type": "color",
        "$value": "{color.ink}",
        "$description": "Inverted surface background."
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Foreground on an inverted surface."
      }
    }
  },
  "elevation": {
    "0": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 0 surface. Flush with the canvas."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px",
            "color": "transparent"
          }
        ],
        "$description": "Level 0 shadow. No ambient or key layer."
      },
      "border": {
        "$type": "color",
        "$value": "transparent",
        "$description": "Level 0 border. Flush surfaces do not stroke."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 0 inset highlight. Unused in light mode."
      }
    },
    "1": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 1 surface. Resting cards and controls."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px",
            "color": "{color.shadow.ambient}"
          },
          {
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "3px",
            "spread": "0px",
            "color": "{color.shadow.key}"
          }
        ],
        "$description": "Level 1 layered shadow. Ambient plus key light."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Level 1 hairline border."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 1 inset highlight. Unused in light mode."
      }
    },
    "2": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 2 surface. Raised cards and menus."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px",
            "color": "{color.shadow.ambient}"
          },
          {
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "10px",
            "spread": "0px",
            "color": "{color.shadow.key}"
          }
        ],
        "$description": "Level 2 layered shadow. Ambient plus key light."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Level 2 hairline border."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 2 inset highlight. Unused in light mode."
      }
    },
    "3": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 3 surface. Popovers and floating panels."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "8px",
            "spread": "0px",
            "color": "{color.shadow.ambient}"
          },
          {
            "offsetX": "0px",
            "offsetY": "8px",
            "blur": "20px",
            "spread": "0px",
            "color": "{color.shadow.key}"
          }
        ],
        "$description": "Level 3 layered shadow. Ambient plus key light."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Level 3 hairline border."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 3 inset highlight. Unused in light mode."
      }
    },
    "4": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 4 surface. Dialogs and sheets."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "8px",
            "blur": "16px",
            "spread": "0px",
            "color": "{color.shadow.ambient}"
          },
          {
            "offsetX": "0px",
            "offsetY": "16px",
            "blur": "32px",
            "spread": "0px",
            "color": "{color.shadow.key}"
          }
        ],
        "$description": "Level 4 layered shadow. Ambient plus key light."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Level 4 hairline border."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 4 inset highlight. Unused in light mode."
      }
    },
    "5": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Level 5 surface. Highest floating layer."
      },
      "shadow": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "12px",
            "blur": "24px",
            "spread": "0px",
            "color": "{color.shadow.ambient}"
          },
          {
            "offsetX": "0px",
            "offsetY": "24px",
            "blur": "48px",
            "spread": "0px",
            "color": "{color.shadow.key}"
          }
        ],
        "$description": "Level 5 layered shadow. Ambient plus key light."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Level 5 hairline border."
      },
      "highlight": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "color": "transparent",
          "inset": true
        },
        "$description": "Level 5 inset highlight. Unused in light mode."
      }
    }
  },
  "material": {
    "solid": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Opaque solid material fill."
      }
    },
    "glass": {
      "bg": {
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.64)",
        "$description": "Translucent glass fill. Contrast is gated on the opaque fallback."
      },
      "fallback": {
        "bg": {
          "$type": "color",
          "$value": "{elevation.2.bg}",
          "$description": "Opaque glass fallback when backdrop-filter is unavailable."
        }
      },
      "blur": {
        "$type": "dimension",
        "$value": "{size.blur.glass}",
        "$description": "Glass backdrop blur radius."
      },
      "saturate": {
        "$type": "number",
        "$value": "{saturate.glass}",
        "$description": "Glass backdrop saturation boost."
      },
      "border": {
        "$type": "color",
        "$value": "{border.hairline}",
        "$description": "Glass hairline border."
      },
      "noise": {
        "$type": "image",
        "$value": "{asset.noise}",
        "$description": "Glass noise overlay image.",
        "opacity": {
          "$type": "number",
          "$value": "{opacity.glass}",
          "$description": "Glass noise overlay opacity."
        }
      }
    },
    "grain": {
      "bg": {
        "$type": "color",
        "$value": "{surface.bg}",
        "$description": "Grain material fill."
      },
      "noise": {
        "$type": "image",
        "$value": "{asset.noise}",
        "$description": "Grain noise overlay image.",
        "opacity": {
          "$type": "number",
          "$value": "{opacity.grain}",
          "$description": "Grain noise overlay opacity."
        }
      }
    }
  },
  "gradient": {
    "accent": {
      "$type": "gradient",
      "$value": {
        "style": "linear",
        "interpolation": "oklch",
        "angle": "135deg",
        "stops": [
          { "color": "{color.primary.600}", "position": 0 },
          { "color": "{color.info.500}", "position": 1 }
        ]
      },
      "$description": "Accent gradient interpolated in oklch."
    },
    "aurora": {
      "$type": "gradient",
      "$value": [
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "14% 18%",
          "stops": [
            { "color": "{color.primary.200}", "position": 0 },
            { "color": "transparent", "position": 0.52 }
          ]
        },
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "86% 12%",
          "stops": [
            { "color": "{color.info.200}", "position": 0 },
            { "color": "transparent", "position": 0.48 }
          ]
        },
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "62% 92%",
          "stops": [
            { "color": "{color.success.100}", "position": 0 },
            { "color": "transparent", "position": 0.55 }
          ]
        }
      ],
      "$description": "Layered radial aurora background interpolated in oklch."
    },
    "border": {
      "$type": "gradient",
      "$value": "{gradient.accent}",
      "$description": "Gradient used by the gradient-border mask recipe."
    }
  },
  "text": {
    "default": {
      "$type": "color",
      "$value": "{surface.fg}",
      "$description": "Default body text on the canvas."
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.700}",
      "$description": "Secondary text on the canvas."
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.600}",
      "$description": "Tertiary text on the canvas. Still meets WCAG 2 AA."
    },
    "inverse": {
      "$type": "color",
      "$value": "{surface.inverse.fg}",
      "$description": "Text on an inverted surface."
    },
    "primary": {
      "$type": "color",
      "$value": "{color.primary.700}",
      "$description": "Primary-colored text on the canvas."
    },
    "success": {
      "$type": "color",
      "$value": "{color.success.700}",
      "$description": "Success-colored text on the canvas."
    },
    "warning": {
      "$type": "color",
      "$value": "{color.warning.700}",
      "$description": "Warning-colored text on the canvas."
    },
    "danger": {
      "$type": "color",
      "$value": "{color.danger.700}",
      "$description": "Danger-colored text on the canvas."
    },
    "info": {
      "$type": "color",
      "$value": "{color.info.700}",
      "$description": "Info-colored text on the canvas."
    }
  },
  "border": {
    "default": {
      "$type": "color",
      "$value": "{color.neutral.300}",
      "$description": "Default structural border."
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.200}",
      "$description": "Low-emphasis border."
    },
    "strong": {
      "$type": "color",
      "$value": "{color.neutral.500}",
      "$description": "High-emphasis border."
    },
    "primary": {
      "$type": "color",
      "$value": "{color.primary.700}",
      "$description": "Primary-accent border."
    },
    "success": {
      "$type": "color",
      "$value": "{color.success.700}",
      "$description": "Success-accent border."
    },
    "warning": {
      "$type": "color",
      "$value": "{color.warning.700}",
      "$description": "Warning-accent border."
    },
    "danger": {
      "$type": "color",
      "$value": "{color.danger.700}",
      "$description": "Danger-accent border."
    },
    "info": {
      "$type": "color",
      "$value": "{color.info.700}",
      "$description": "Info-accent border."
    },
    "focus": {
      "$type": "color",
      "$value": "{focus.ring.color}",
      "$description": "Focus-indicator border."
    },
    "hairline": {
      "$type": "color",
      "$value": "{color.hairline}",
      "$description": "Alpha hairline border color.",
      "width": {
        "$type": "dimension",
        "$value": "{size.hairline}",
        "$description": "Hairline width. 1px at 1x, 0.5px on high-DPR screens.",
        "$extensions": {
          "slop.ui": {
            "highDpr": "0.5px"
          }
        }
      }
    }
  },
  "action": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{color.primary.700}",
        "$description": "Solid primary action background. Maps to SlButton tone accent.",
        "hover": {
          "$type": "color",
          "$value": "{color.primary.800}",
          "$description": "Solid primary action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.primary.900}",
          "$description": "Solid primary action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid primary action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.primary.bg}",
        "$description": "Border on a solid primary action."
      }
    },
    "neutral": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.700}",
        "$description": "Solid neutral action background.",
        "hover": {
          "$type": "color",
          "$value": "{color.neutral.800}",
          "$description": "Solid neutral action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.neutral.900}",
          "$description": "Solid neutral action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid neutral action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.neutral.bg}",
        "$description": "Border on a solid neutral action."
      }
    },
    "success": {
      "bg": {
        "$type": "color",
        "$value": "{color.success.700}",
        "$description": "Solid success action background.",
        "hover": {
          "$type": "color",
          "$value": "{color.success.800}",
          "$description": "Solid success action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.success.900}",
          "$description": "Solid success action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid success action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.success.bg}",
        "$description": "Border on a solid success action."
      }
    },
    "warning": {
      "bg": {
        "$type": "color",
        "$value": "{color.warning.800}",
        "$description": "Solid warning action background. Uses 800 so white label text meets WCAG AA.",
        "hover": {
          "$type": "color",
          "$value": "{color.warning.900}",
          "$description": "Solid warning action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.warning.950}",
          "$description": "Solid warning action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid warning action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.warning.bg}",
        "$description": "Border on a solid warning action."
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.700}",
        "$description": "Solid danger action background.",
        "hover": {
          "$type": "color",
          "$value": "{color.danger.800}",
          "$description": "Solid danger action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.danger.900}",
          "$description": "Solid danger action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid danger action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.danger.bg}",
        "$description": "Border on a solid danger action."
      }
    },
    "info": {
      "bg": {
        "$type": "color",
        "$value": "{color.info.700}",
        "$description": "Solid info action background.",
        "hover": {
          "$type": "color",
          "$value": "{color.info.800}",
          "$description": "Solid info action background on hover."
        },
        "active": {
          "$type": "color",
          "$value": "{color.info.900}",
          "$description": "Solid info action background on press."
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Content color on a solid info action."
      },
      "border": {
        "$type": "color",
        "$value": "{action.info.bg}",
        "$description": "Border on a solid info action."
      }
    },
    "disabled": {
      "opacity": {
        "$type": "number",
        "$value": "{opacity.disabled}",
        "$description": "Shared unavailable-state opacity."
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.2}",
      "$description": "Space between action label and icon content."
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}",
      "$description": "Action corner radius."
    },
    "duration": {
      "$type": "duration",
      "$value": "{motion.duration.fast}",
      "$description": "Action color and opacity transition duration.",
      "$extensions": {
        "slop.ui": {
          "reducedMotion": "80ms"
        }
      }
    },
    "label": {
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.semibold}",
        "$description": "Action label font weight."
      }
    },
    "icon": {
      "size": {
        "$type": "dimension",
        "$value": "{size.icon}",
        "$description": "Action icon size."
      }
    },
    "spinner": {
      "size": {
        "$type": "dimension",
        "$value": "{size.icon}",
        "$description": "Action loading-indicator size."
      },
      "width": {
        "$type": "dimension",
        "$value": "{size.spinner.width}",
        "$description": "Default action spinner stroke width."
      }
    }
  },
