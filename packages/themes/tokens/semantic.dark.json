      }
    }
  },
  "gradient": {
    "accent": {
      "$type": "gradient",
      "$value": {
        "style": "linear",
        "interpolation": "oklch",
        "angle": "135deg",
        "stops": [
          { "color": "{color.primary.dark.400}", "position": 0 },
          { "color": "{color.info.dark.400}", "position": 1 }
        ]
      }
    },
    "aurora": {
      "$type": "gradient",
      "$value": [
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "14% 18%",
          "stops": [
            { "color": "{color.primary.dark.700}", "position": 0 },
            { "color": "transparent", "position": 0.52 }
          ]
        },
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "86% 12%",
          "stops": [
            { "color": "{color.info.dark.700}", "position": 0 },
            { "color": "transparent", "position": 0.48 }
          ]
        },
        {
          "style": "radial",
          "interpolation": "oklch",
          "at": "62% 92%",
          "stops": [
            { "color": "{color.success.dark.800}", "position": 0 },
            { "color": "transparent", "position": 0.55 }
          ]
        }
      ]
    }
  },
