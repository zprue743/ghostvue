{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@ghostvue/vue": ["../vue/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "../vue/src/**/*.ts",
    "../vue/src/**/*.vue"
  ],
  "exclude": ["../vue/src/**/*.test.ts"]
}
