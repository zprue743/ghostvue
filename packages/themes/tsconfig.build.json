{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // Published output carries no source maps: the tarball ships only dist/,
    // so maps would point at src/ files consumers never receive (#347).
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/.publish-index.generated.ts"
  ],
  "exclude": [
    "src/index.ts",
    "src/components.ts",
    "src/**/*.test.ts",
    "src/.registries/**/*.ts"
  ]
}
