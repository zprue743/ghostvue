{
  "name": "@ghostvue/themes",
  "version": "0.0.0",
  "private": true,
  "description": "Optional design-token and theme infrastructure for GhostVue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zprue743/ghostvue.git",
    "directory": "packages/themes"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "node": "./dist/define.js",
      "import": "./dist/define.js",
      "default": "./dist/define.js"
    },
    "./default.css": "./dist/default.css",
    "./base.css": "./dist/base.css",
    "./recipes/*.css": "./dist/recipes/*.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./calm.css": "./dist/calm.css",
    "./vibrant.css": "./dist/vibrant.css",
    "./mono.css": "./dist/mono.css",
    "./manifest.json": "./dist/manifest.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "pnpm -w registries:write",
    "build": "node scripts/compile-tokens.mjs && tsc -p tsconfig.build.json && node ../../scripts/finalize-publish-index.mjs dist && node scripts/copy-css.mjs && node scripts/bundle-define.mjs && node ../../scripts/finalize-declarations.mjs dist && node ../../scripts/write-manifest-collection.mjs --package @ghostvue/themes",
    "pretypecheck": "pnpm -w registries:write",
    "define-theme": "node scripts/define-theme.mjs",
    "typecheck": "node scripts/compile-tokens.mjs && vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@ghostvue/vue": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ghostvue/vue": "workspace:*",
    "culori": "4.0.2",
    "esbuild": "0.28.2",
    "vue": "3.5.45"
  },
  "typesVersions": {
    "*": {
      "define": [
        "./dist/define.d.ts"
      ],
      "components": [
        "./dist/components.d.ts"
      ]
    }
  }
}
