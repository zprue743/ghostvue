{
  "name": "@ghostvue/themes",
  "version": "0.0.0",
  "private": true,
  "description": "Optional design-token and theme infrastructure for GhostVue.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "node": "./dist/define.js",
      "import": "./dist/define.js",
      "default": "./dist/define.js"
    },
    "./default.css": "./dist/default.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./calm.css": "./dist/calm.css",
    "./vibrant.css": "./dist/vibrant.css",
    "./mono.css": "./dist/mono.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/compile-tokens.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "define-theme": "node scripts/define-theme.mjs",
    "typecheck": "node scripts/compile-tokens.mjs && vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostvue/vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "culori": "4.0.2",
    "vue": "3.5.41"
  }
}
