{
  "schemaVersion": "1.0.0",
  "source": "handwritten",
  "name": "GhostCombobox",
  "package": "@ghostvue/themes",
  "status": "experimental",
  "description": "Themed GhostCombobox root, input, trigger, and list surfaces using --ghost-* tokens.",
  "props": [],
  "models": [],
  "events": [],
  "slots": [
    {
      "name": "default",
      "props": [],
      "description": "Combobox parts composed by the consumer."
    }
  ],
  "exposed": [
    {
      "name": "element",
      "kind": "property",
      "type": "HTMLElement | null",
      "description": "Combobox input element after mount."
    },
    {
      "name": "focus",
      "kind": "method",
      "type": "(options?: FocusOptions) => void",
      "description": "Focuses the combobox input."
    },
    {
      "name": "blur",
      "kind": "method",
      "type": "() => void",
      "description": "Blurs the combobox input."
    }
  ],
  "styling": {
    "parts": [
      {
        "name": "input",
        "description": "Themed text field with .ghost-combobox-input."
      },
      {
        "name": "content",
        "description": "Elevated list surface with .ghost-combobox-content."
      },
      {
        "name": "trigger",
        "description": "Optional toggle button with .ghost-combobox-trigger."
      }
    ],
    "states": [
      {
        "name": "open",
        "description": "Input or trigger data-state when the listbox is open."
      }
    ],
    "cssProperties": [
      {
        "name": "--ghost-surface-bg",
        "description": "Input and trigger background."
      },
      {
        "name": "--ghost-elevation-3-bg",
        "description": "List surface background."
      }
    ]
  },
  "accessibility": {
    "role": "combobox",
    "apgPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/combobox/examples/combobox-autocomplete-list/",
    "keyboard": {},
    "requiredAriaAttributes": []
  },
  "examples": [
    "combobox/assignee-search",
    "combobox/review-request-form",
    "combobox/themed"
  ]
}