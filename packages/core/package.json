{
  "name": "@slop-ui/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent behavior and contracts for slop-ui.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "files": [
    "dist",
    "manifest.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slop-ui/shared": "workspace:*"
  }
}
