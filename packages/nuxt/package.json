{
  "name": "@ghostvue/nuxt",
  "version": "0.0.0",
  "private": true,
  "description": "Nuxt module for GhostVue: headless auto-imports by default, opt-in themed wrappers and theme CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zprue743/ghostvue.git",
    "directory": "packages/nuxt"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "pnpm -w registries:write",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm -w registries:write",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "4.6.4",
    "@nuxt/schema": "4.6.4"
  },
  "peerDependencies": {
    "@ghostvue/themes": "workspace:*",
    "@ghostvue/vue": "workspace:*",
    "nuxt": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@ghostvue/themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ghostvue/themes": "workspace:*",
    "@ghostvue/vue": "workspace:*",
    "nuxt": "4.6.4",
    "vite": "8.3.5"
  }
}
