{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".declaration-build/src",
    "outDir": "dist"
  },
  "include": [
    ".declaration-build/src/**/*.ts",
    ".declaration-build/src/**/*.vue"
  ],
  "exclude": [
    ".declaration-build/src/**/*.test.ts",
    ".declaration-build/src/dev-codes-docs.ts",
    ".declaration-build/src/overlay-ssr.test.ts"
  ]
}
