{
  "name": "@ghostvue/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 integration for the headless-first GhostVue library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ghostvue.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@ghostvue/core": "workspace:*",
    "@ghostvue/shared": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "3.5.41"
  }
}
