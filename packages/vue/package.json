{
  "name": "@ghostvue/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 integration for the headless-first GhostVue library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ghostvue.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm -w registries:write",
    "build": "vite build && node ../../scripts/stage-vue-declaration-tree.mjs && vue-tsc -p tsconfig.declarations.json --emitDeclarationOnly && node ../../scripts/finalize-declarations.mjs dist",
    "pretypecheck": "pnpm -w registries:write",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit && node ../../scripts/vue-type-tests-negative.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@ghostvue/core": "workspace:*",
    "@ghostvue/shared": "workspace:*",
    "@internationalized/date": "3.12.4"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "3.5.45"
  }
}
