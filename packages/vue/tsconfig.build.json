{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "tsBuildInfoFile": null,
    "rootDir": "src",
    "declarationMap": false
  },
  "references": [],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/**/*.test.ts",
    "src/dev-codes-docs.ts",
    "src/.registries/**/*.ts",
    "src/.publish-index.generated.ts",
    "src/.publish-build/**",
    ".declaration-build/**"
  ]
}
