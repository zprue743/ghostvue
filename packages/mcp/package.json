{
  "name": "@ghostvue/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only Model Context Protocol stdio server for discovering GhostVue components, examples, docs, and design tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zprue743/ghostvue.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ghostvue"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "ghostvue-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "pnpm -w registries:write",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-assets.mjs",
    "assets:check": "node scripts/bundle-assets.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "zod": "4.6.7"
  }
}
