{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency update policy (GHO-53). See docs/contributing/ci.md.",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "pin",
  "automerge": false,
  "platformAutomerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "automerge": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Playwright container image tag used for local visual baselines and the Cursor agent environment.",
      "managerFilePatterns": [
        "/^scripts/lib/test-visual-docker\\.js$/",
        "/^\\.cursor/environment\\.json$/"
      ],
      "matchStrings": [
        "(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>v[0-9][^\\s'\"]*)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: one grouped PR; helpers:pinGitHubActionDigests keeps refs as commit SHAs with a version comment.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Keep Chromium, fonts, and the Playwright runner in lockstep: the CI container tag must match @playwright/test.",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "playwright-core",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "Playwright"
    },
    {
      "description": "Node and pnpm runtime majors change the support matrix; review them individually.",
      "matchDepNames": ["node", "pnpm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
