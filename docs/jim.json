{
  // The built-in 3.8 Flash chat preset already uses HIGH thinking.
  "model": { "name": "gemini-3.8-flash" },
  // Enable the ID rules below for model selection and built-in fallback chains.
  "experimental": { "dynamicModelConfiguration": true },
  "modelConfigs": {
    // Change only the destination. Each helper keeps its own tools and generation settings.
    "customOverrides": [
      {
        "match": { "model": "gemini-3-flash-preview" },
        "modelConfig": { "model": "gemini-3.8-flash" }
      },
      {
        "match": { "model": "flash-lite" },
        "modelConfig": { "model": "gemini-3.5-flash-lite" }
      }
    ],
    "modelIdResolutions": {
      "gemini-3-flash-preview": { "default": "gemini-3.8-flash", "contexts": [] },
      "flash-lite": { "default": "gemini-3.5-flash-lite", "contexts": [] },

      // Honor both explicit IDs even when the CLI's rollout flags are off.
      "gemini-3.8-flash": { "default": "gemini-3.8-flash", "contexts": [] },
      "gemini-3.5-flash-lite": { "default": "gemini-3.5-flash-lite", "contexts": [] },

      // The generic Flash tier can select preview in a single lookup. Replace that branch
      // and retain the CLI's current stable choices. These tier choices are explicit.
      "flash": {
        "default": "gemini-3.8-flash",
        "contexts": [
          { "condition": { "useLatestFlash": true }, "target": "gemini-3.8-flash" },
          { "condition": { "hasAccessToPreview": false }, "target": "gemini-3.5-flash" }
        ]
      }
    }
  }
}
